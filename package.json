{
  "name": "stoxscraper",
  "version": "0.0.3",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "nest start --exec 'node --max-http-header-size=80000'",
    "start:dev": "nest start --watch --exec 'node --max-http-header-size=80000'",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-http-header-size=80000 dist/main.js",
    "browser:install": "playwright install chromium",
    "browser:install-deps": "playwright install-deps chromium",
    "cookies:setup": "node --env-file-if-exists=.env playwright-cookie-setup.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test:cov -- --runInBand",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:integration": "npm test -- --testPathPatterns=integration.spec.ts --runInBand",
    "test:unit": "npm test -- --testPathIgnorePatterns=integration.spec.ts --runInBand",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "cache-manager": "^7.2.9",
    "cheerio": "^1.2.0",
    "keyv": "^6.1.0",
    "playwright": "^1.64.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      },
      "./src/asset/asset.service.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      },
      "./src/utilities/playwright.service.ts": {
        "statements": 95,
        "branches": 85,
        "functions": 100,
        "lines": 95
      },
      "./src/asset/gold-api.service.ts": {
        "statements": 95,
        "branches": 90,
        "functions": 100,
        "lines": 95
      }
    },
    "testEnvironment": "node"
  }
}
